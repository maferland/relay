{
  "name": "agent-tasks",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first task tracker for coordinating multi-agent work — log tasks, hand off for QA, poll for state changes",
  "license": "MIT",
  "bin": {
    "tasks": "dist/tasks"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:ui": "bunx vite build",
    "dev": "bun --watch src/cli.ts",
    "dev:ui": "bunx vite",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p tsconfig.ui.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
